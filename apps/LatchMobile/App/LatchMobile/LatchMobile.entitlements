<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Attention alerts. The visible payload is a fixed sentence unless the
	  notification service extension opens the blob the Mac sealed to this
	  phone and names the session. `development` matches a development-signed build and the control plane's
	  APNS_ENVIRONMENT=sandbox; a TestFlight/App Store build is re-signed with
	  `production` by Xcode automatically.
	-->
	<key>aps-environment</key>
	<string>development</string>
	<!--
	  Shared with LatchNotificationService so it can read the notification
	  key (and nothing else: the identity and pairing records stay in the
	  app's own default group).
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)dev.cooperativ.latch.shared</string>
	</array>
</dict>
</plist>
