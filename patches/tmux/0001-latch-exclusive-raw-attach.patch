 void
+tty_latch_raw_write(struct tty *tty, const void *buf, size_t len)
+{
+	struct client	*c = tty->client;
+	size_t		 queued = EVBUFFER_LENGTH(tty->out);
+
+	if (c->latch_raw_state != LATCH_RAW_LIVE)
+		return;
+	if (len > 1024 * 1024 || queued > 1024 * 1024 - len ||
+	    c->latch_raw_chunk_count >= 2048) {
+		server_client_latch_raw_close(c, "latch_raw_slow_client", 76);
+		return;
+	}
+	if (c->latch_raw_chunk_sizes == NULL)
+		c->latch_raw_chunk_sizes = xcalloc(2048,
+		    sizeof *c->latch_raw_chunk_sizes);
+	evbuffer_add(tty->out, buf, len);
+	c->latch_raw_chunk_sizes[(c->latch_raw_chunk_head +
+	    c->latch_raw_chunk_count) % 2048] = len;
+	c->latch_raw_chunk_count++;
+	c->written += len;
+	if ((tty->flags & TTY_STARTED) &&
+	    !event_pending(&tty->event_out, EV_WRITE, NULL))
+		event_add(&tty->event_out, NULL);
