+/*
+ * Restore input-affecting pane modes for the raw terminal. Normal tmux clients
+ * consume these modes and translate input themselves, so the regular redraw
+ * deliberately does not mirror all of them onto the outer terminal. A raw
+ * client bypasses that translation and must inherit the pane's exact modes at
+ * the snapshot boundary.
+ */
+static void
+server_client_latch_raw_modes(struct client *c)
+{
+	struct tty	*tty = &c->tty;
+	struct screen	*s = c->latch_raw_wp->screen;
+	int		 mode = s->mode;
+
+	if (mode & MODE_FOCUSON)
+		tty_puts(tty, "\033[?1004h");
+	else
+		tty_puts(tty, "\033[?1004l");
+
+	tty_puts(tty, "\033[?1000l\033[?1002l\033[?1003l");
+	if (mode & MODE_MOUSE_ALL)
+		tty_puts(tty, "\033[?1003h");
+	else if (mode & MODE_MOUSE_BUTTON)
+		tty_puts(tty, "\033[?1002h");
+	else if (mode & MODE_MOUSE_STANDARD)
+		tty_puts(tty, "\033[?1000h");
+
+	tty_puts(tty, "\033[?1005l\033[?1006l");
+	if (mode & MODE_MOUSE_UTF8)
+		tty_puts(tty, "\033[?1005h");
+	if (mode & MODE_MOUSE_SGR)
+		tty_puts(tty, "\033[?1006h");
+
+	if (mode & MODE_BRACKETPASTE)
+		tty_puts(tty, "\033[?2004h");
+	else
+		tty_puts(tty, "\033[?2004l");
+
+	switch (mode & EXTENDED_KEY_MODES) {
+	case MODE_KEYS_EXTENDED_2:
+		tty_puts(tty, "\033[>4;2m");
+		break;
+	case MODE_KEYS_EXTENDED:
+		tty_puts(tty, "\033[>4;1m");
+		break;
+	default:
+		tty_puts(tty, "\033[>4m");
+		break;
+	}
 }
 
