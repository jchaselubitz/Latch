+static size_t
+window_pane_unparsed(struct window_pane *wp)
+{
+	size_t	used;
+
+	if (wp->event == NULL)
+		return (0);
+	used = wp->offset.used - wp->base_offset;
+	if (used >= EVBUFFER_LENGTH(wp->event->input))
+		return (0);
+	return (EVBUFFER_LENGTH(wp->event->input) - used);
+}
+
+static void
+window_pane_parse_timer(__unused int fd, __unused short events, void *data)
+{
+	window_pane_parse_work(data);
 }
 
+static void
+window_pane_schedule_parse(struct window_pane *wp)
+{
+	struct timeval	tv = { .tv_sec = 0, .tv_usec = 1000 };
+
+	if (window_pane_unparsed(wp) == 0)
+		return;
+	if (!event_initialized(&wp->parse_timer))
+		evtimer_set(&wp->parse_timer, window_pane_parse_timer, wp);
+	if (!evtimer_pending(&wp->parse_timer, NULL))
+		evtimer_add(&wp->parse_timer, &tv);
+}
+
+static void
+window_pane_parse_work(struct window_pane *wp)
+{
+	size_t	unparsed;
+
+	unparsed = window_pane_unparsed(wp);
+	if (unparsed == 0)
+		return;
+	if (unparsed > LATCH_PARSE_BACKLOG)
+		input_parse_pane_n(wp, LATCH_PARSE_CATCHUP);
+	else
+		input_parse_pane_n(wp, LATCH_PARSE_SLICE);
+	if (window_pane_unparsed(wp) > 0)
+		window_pane_schedule_parse(wp);
+}
