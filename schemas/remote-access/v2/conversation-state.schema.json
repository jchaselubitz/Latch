{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latch.cooperativ.dev/schemas/remote-access/v2/conversation-state.schema.json",
  "title": "LatchConversationStateV2",
  "description": "Current agent state and operation availability. pendingRequest is derived from the newest pending request item and is never updated independently.",
  "$defs": {
    "availability": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "reason": { "type": ["string", "null"], "maxLength": 4096 }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["phase", "sendMessage", "resolveRequest", "pendingRequest", "connector"],
  "properties": {
    "phase": { "enum": ["starting", "idle", "working", "awaiting_input", "exited", "unavailable"] },
    "sendMessage": { "$ref": "#/$defs/availability" },
    "resolveRequest": { "$ref": "#/$defs/availability" },
    "cancelTurn": { "$ref": "#/$defs/availability" },
    "turnOutcome": {
      "description": "Why the agent closed its newest turn, in its own vocabulary, carried only while no turn is open. Absent or null when the connector has no outcome to report.",
      "enum": ["answer", "aborted", "refusal", "error", null]
    },
    "commands": {
      "description": "Slash commands the agent advertises for its composer, relayed from a live agent bridge. Absent means the Hub does not know them, not that there are none.",
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 128 },
          "description": { "type": "string", "maxLength": 512 },
          "source": { "type": "string", "maxLength": 64 }
        },
        "additionalProperties": false
      }
    },
    "pendingRequest": { "type": ["string", "null"], "maxLength": 256 },
    "connector": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["id", "version"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "version": { "type": "string", "minLength": 1, "maxLength": 128 }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
