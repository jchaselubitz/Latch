{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latch.cooperativ.dev/schemas/remote-access/v2/terminal-connection.schema.json",
  "title": "LatchTerminalConnectionV2",
  "description": "Query contract for WS /v2/sessions/{id}/terminal. Direct loopback clients default to control. Paired clients require control unless mode=read-only.",
  "type": "object",
  "properties": {
    "mode": { "enum": ["control", "read-only"], "default": "control" },
    "cols": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "rows": { "type": "integer", "minimum": 1, "maximum": 65535 }
  },
  "additionalProperties": false
}
