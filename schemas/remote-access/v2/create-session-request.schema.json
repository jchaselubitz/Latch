{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latch.cooperativ.dev/schemas/remote-access/v2/create-session-request.schema.json",
  "title": "LatchCreateSessionRequestV2",
  "description": "The only caller-controlled inputs for a mobile-created standard shell.",
  "type": "object",
  "required": ["requestId", "cwd"],
  "properties": {
    "requestId": { "type": "string", "format": "uuid" },
    "cwd": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/" }
  },
  "additionalProperties": false
}
