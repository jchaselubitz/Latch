{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latch.cooperativ.dev/schemas/remote-access/v2/gateway-capabilities.schema.json",
  "title": "LatchGatewayCapabilitiesV2",
  "description": "Canonical discovery document for the Latch protocol-major-2 gateway. No v1 discovery route exists.",
  "type": "object",
  "required": ["protocolVersion", "productVersion", "capabilities", "endpoints", "features", "gatewayInstanceId", "operationRetentionSeconds"],
  "properties": {
    "protocolVersion": { "const": 2 },
    "productVersion": { "type": "string" },
    "capabilities": {
      "type": "object",
      "required": ["create", "openViewer", "localAttach", "cloudAttach", "selfUpdate", "extensions"],
      "properties": {
        "create": { "type": "boolean" },
        "openViewer": { "type": "boolean" },
        "localAttach": { "type": "boolean" },
        "cloudAttach": { "type": "boolean" },
        "selfUpdate": { "type": "boolean" },
        "extensions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "endpoints": {
      "type": "object",
      "required": ["sessions", "terminal", "conversation"],
      "properties": {
        "sessions": { "type": "boolean" },
        "terminal": { "type": "boolean" },
        "conversation": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "features": {
      "type": "object",
      "required": ["readOnlyTerminal"],
      "properties": {
        "readOnlyTerminal": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "gatewayInstanceId": { "type": "string", "pattern": "^gw-[0-9a-f]+-[0-9a-f]+$" },
    "operationRetentionSeconds": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false
}
