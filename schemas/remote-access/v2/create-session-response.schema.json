{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latch.cooperativ.dev/schemas/remote-access/v2/create-session-response.schema.json",
  "title": "LatchCreateSessionResponseV2",
  "description": "The existing latch create report returned for a mobile-created shell.",
  "type": "object",
  "required": ["protocolVersion", "session"],
  "properties": {
    "protocolVersion": { "const": 2 },
    "session": {
      "type": "object",
      "required": ["id", "name", "state", "createdAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
