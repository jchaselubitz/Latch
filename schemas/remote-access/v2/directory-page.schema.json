{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latch.cooperativ.dev/schemas/remote-access/v2/directory-page.schema.json",
  "title": "LatchDirectoryPageV2",
  "description": "One bounded page of canonical directories on the gateway host.",
  "type": "object",
  "required": ["path", "parent", "entries", "nextCursor"],
  "properties": {
    "path": { "type": "string", "minLength": 1, "pattern": "^/" },
    "parent": { "type": ["string", "null"], "pattern": "^/" },
    "entries": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["name", "path"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1, "pattern": "^/" }
        },
        "additionalProperties": false
      }
    },
    "nextCursor": { "type": ["string", "null"], "maxLength": 160 }
  },
  "additionalProperties": false
}
