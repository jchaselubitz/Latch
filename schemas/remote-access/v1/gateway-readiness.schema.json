{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latch.cooperativ.dev/schemas/remote-access/v1/gateway-readiness.schema.json",
  "title": "LatchGatewayReadinessV1",
  "description": "Private supervisor handoff written only after latch serve has bound its loopback listener. It never contains a gateway token.",
  "type": "object",
  "required": ["formatVersion", "address", "url", "protocolVersion", "gatewayInstanceId"],
  "properties": {
    "formatVersion": { "const": 1 },
    "address": { "type": "string" },
    "url": { "type": "string", "pattern": "^http://" },
    "protocolVersion": { "const": 1 },
    "gatewayInstanceId": { "type": "string", "pattern": "^gw-[0-9a-f]+-[0-9a-f]+$" }
  },
  "additionalProperties": false
}
