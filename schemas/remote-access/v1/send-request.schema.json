{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latch.cooperativ.dev/schemas/remote-access/v1/send-request.schema.json",
  "title": "LatchSendRequestV1",
  "description": "Request body for POST /v1/sessions/{id}/send. Idempotency-Key is an HTTP header and applies only to message and resolve operations.",
  "oneOf": [
    { "type": "object", "required": ["message"], "properties": { "message": { "type": "string" } }, "additionalProperties": false },
    { "type": "object", "required": ["keys"], "properties": { "keys": { "type": "string" } }, "additionalProperties": false },
    { "type": "object", "required": ["resolve"], "properties": { "resolve": { "type": "object", "required": ["requestId", "choice"], "properties": { "requestId": { "type": "string" }, "choice": { "type": "string" } }, "additionalProperties": false } }, "additionalProperties": false }
  ]
}
