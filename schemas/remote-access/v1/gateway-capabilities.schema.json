{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latch.cooperativ.dev/schemas/remote-access/v1/gateway-capabilities.schema.json",
  "title": "LatchGatewayCapabilitiesV1",
  "description": "Canonical discovery document for the additive Latch /v1 gateway contract.",
  "type": "object",
  "required": ["protocolVersion", "productVersion", "capabilities", "endpoints", "features", "gatewayInstanceId"],
  "properties": {
    "protocolVersion": { "const": 1 },
    "productVersion": { "type": "string" },
    "capabilities": { "type": "object" },
    "endpoints": {
      "type": "object",
      "required": ["sessions", "sessionCapabilities", "terminal", "events", "send"],
      "properties": {
        "sessions": { "type": "boolean" },
        "sessionCapabilities": { "type": "boolean" },
        "terminal": { "type": "boolean" },
        "events": { "type": "boolean" },
        "send": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "features": {
      "type": "object",
      "required": ["idempotencyKeys", "readOnlyTerminal"],
      "properties": {
        "idempotencyKeys": { "type": "boolean" },
        "readOnlyTerminal": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "gatewayInstanceId": { "type": "string", "pattern": "^gw-[0-9a-f]+-[0-9a-f]+$" }
  },
  "additionalProperties": true
}
