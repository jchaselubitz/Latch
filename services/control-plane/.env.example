# Latch control plane configuration.
#
# Copy to .env for local development. Railway injects PORT, DATABASE_URL,
# RAILWAY_GIT_COMMIT_SHA, and RAILWAY_ENVIRONMENT_NAME automatically.

# Required. On Railway, reference the database service:
#   ${{ Postgres.DATABASE_URL }}
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/latch_control_plane

# HTTP listener.
PORT=8080
HOST=0.0.0.0

# Apply pending migrations during boot. Leave on unless a release pipeline
# runs `npm run migrate` as a separate step.
MIGRATE_ON_BOOT=true

# Bounds.
MAX_DEVICES_PER_ACCOUNT=32
RATE_LIMIT_PER_MINUTE=240
# Layered Remote Link admission budgets. TRUST_PROXY is appropriate only when
# the hosting edge overwrites X-Forwarded-For before requests reach Node.
REMOTE_ADMISSION_RATE_PER_DEVICE=60
REMOTE_ADMISSION_RATE_PER_OWNER=180
REMOTE_ADMISSION_RATE_PER_IP=120
REMOTE_ADMISSION_RATE_GLOBAL=1000
TRUST_PROXY=true
DATABASE_POOL_SIZE=10
DATABASE_SSL_REJECT_UNAUTHORIZED=false
# Remote Link v1 bootstrap and relay credentials. Store these in Railway's
# secret store; do not commit real values.
OPERATOR_SECRET=replace-with-at-least-32-random-characters
ADMISSION_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
ADMISSION_KEY_ID=latch-remote-link-v1
ADMISSION_ISSUER=https://control.example.com
RELAY_URL=wss://relay.example.com/v1/connect
RELAY_SERVICE_TOKEN=replace-with-at-least-32-random-characters
RELAY_INVALIDATION_SECRET=replace-with-at-least-32-random-characters
# Attention notifications (optional). All three APNs values must be set
# together; the topic is the iOS bundle identifier and the environment must
# match how the tested phone build is signed (development signing = sandbox).
APNS_KEY_ID=ABCDE12345
APNS_TEAM_ID=X84RPB4674
APNS_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
APNS_TOPIC=dev.cooperativ.latch.mobile
APNS_ENVIRONMENT=sandbox
ATTENTION_RATE_PER_HOST=60
