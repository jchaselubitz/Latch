# Latch control plane configuration.
#
# Copy to .env for local development. Railway injects PORT, DATABASE_URL,
# RAILWAY_GIT_COMMIT_SHA, and RAILWAY_ENVIRONMENT_NAME automatically.

# Required. On Railway, reference the database service:
#   ${{ Postgres.DATABASE_URL }}
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/latch_control_plane

# HTTP listener.
PORT=8080
HOST=0.0.0.0

# Apply pending migrations during boot. Leave on unless a release pipeline
# runs `npm run migrate` as a separate step.
MIGRATE_ON_BOOT=true

# Cloudflare Realtime TURN key ID and the server-only API token authorized to
# generate/revoke credentials for that key. Set both as Railway sealed
# variables; neither may be exposed to a device or committed to source.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Short-lived windows. Defaults mirror the local Rust protocol model.
PRESENCE_TTL_SECONDS=90
RENDEZVOUS_TTL_SECONDS=60
# Keep credentials short-lived. Revocation also calls Cloudflare immediately.
CLOUDFLARE_TURN_TTL_SECONDS=120

# Bounds.
MAX_DEVICES_PER_ACCOUNT=32
MAX_CANDIDATES=8
RATE_LIMIT_PER_MINUTE=240
DATABASE_POOL_SIZE=10
DATABASE_SSL_REJECT_UNAUTHORIZED=false
